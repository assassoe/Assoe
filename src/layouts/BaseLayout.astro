---
import { getImage } from 'astro:assets';
import '@/styles/global.css';
import SiteBrand from '@/components/SiteBrand.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { contentRepository } from '@/content';
import type { AssociationInfo } from '@/content/types';
import { siteNavigation } from '@/config/navigation';
import { SITE_NAME } from '@/config/site';
import { sitePath } from '@/utils/sitePath';
import { initiativeNavigationPath } from '@/utils/initiatives';
import { getPageAssociation } from '@/utils/association';

interface Props {
  /** Titolo della pagina; il layout aggiunge il nome completo dell’associazione. */
  title?: string;
  description?: string;
  socialImage?: string;
  association?: AssociationInfo | null;
  navigationPath?: string;
}

const {
  title: pageTitle,
  association: providedAssociation,
} = Astro.props;

const association = providedAssociation === undefined
  ? await getPageAssociation(Astro.locals, contentRepository)
  : providedAssociation;
const name = association?.name ?? SITE_NAME;
const title = pageTitle ? `${pageTitle} | ${name}` : name;
const description = Astro.props.description?.trim()
  || (pageTitle
    ? `${pageTitle}. Attività e iniziative di ${name}.`
    : association?.shortDescription?.trim() || `Volontariato, iniziative sociali, eventi e racconti di ${name}.`);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialSource = [Astro.props.socialImage, association?.aboutImageUrl]
  .find((source) => source && !source.split(/[?#]/, 1)[0].toLowerCase().endsWith('.svg'));
let socialImage = null;
if (socialSource) {
  socialImage = await getImage({ src: socialSource, width: 1200, height: 630, fit: 'contain', format: 'png' });
}
let favicon = null;
const svgLogo = association?.logoUrl?.split(/[?#]/, 1)[0].toLowerCase().endsWith('.svg');
if (association?.logoUrl) {
  try {
    favicon = await getImage({ src: association.logoUrl, width: 64, height: 64, fit: 'contain', format: svgLogo ? 'svg' : 'png' });
  } catch {
    // Il logo remoto non deve impedire il rendering della pagina.
  }
}

const currentPath = initiativeNavigationPath(Astro.props.navigationPath ?? Astro.url.pathname);
const homePath = sitePath('/');
const isCurrent = (href: string) => href === homePath ? currentPath === homePath : currentPath.startsWith(href);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && Astro.site && <>
      <meta property="og:image" content={new URL(socialImage.src, Astro.site).href} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={title} />
    </>}
    {favicon && <link rel="icon" type={svgLogo ? 'image/svg+xml' : 'image/png'} href={favicon.src} />}
    {import.meta.env.PUBLIC_SITE_PREVIEW === 'true' && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <SiteBrand association={association} />
        <nav class="desktop-nav" aria-label="Navigazione principale">
          {siteNavigation.map((item) => <a href={item.href} class:list={{ 'nav-cta': item.featured }} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <details class="mobile-nav">
          <summary>
            <span class="visually-hidden">Menu di navigazione</span>
            <span class="mobile-nav__icon" aria-hidden="true"><span></span><span></span><span></span></span>
          </summary>
          <nav aria-label="Navigazione mobile">
            {siteNavigation.map((item) => <a href={item.href} class:list={{ 'nav-cta': item.featured }} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <slot />
    <SiteFooter association={association} />
  </body>
</html>
