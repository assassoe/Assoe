---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeSections from '@/components/HomeSections.astro';
import ContentImage from '@/components/ContentImage.astro';
import HomeHeroIntro from '@/components/HomeHeroIntro.astro';
import { contentRepository } from '@/content';
import { getNextEvent } from '@/utils/events';
import { SITE_NAME } from '@/config/site';
import { sitePath } from '@/utils/sitePath';

const [homeSections, notices, initiatives, articles, events, association] = await Promise.all([
  contentRepository.listHomeSections(),
  contentRepository.listHomeNotices(),
  contentRepository.listInitiatives(),
  contentRepository.listArticles(),
  contentRepository.listEvents(),
  contentRepository.getAssociationInfo(),
]);

const featuredEvent = getNextEvent(events);
---

<BaseLayout title={SITE_NAME} association={association}>
  <main id="contenuto">
    <section class="hero">
      <div class="container hero__panel">
        <div class="hero__text">
          <HomeHeroIntro name={association?.name ?? SITE_NAME} shortDescription={association?.shortDescription} />
          <div class="hero__actions">
            <a class="button" href={sitePath('/iniziative/')}>Scopri le iniziative</a>
            <a class="button button--light" href={sitePath('/chi-siamo/')}>Chi siamo</a>
          </div>
        </div>
        {association?.logoUrl ? (
          <div class="hero__logo"><ContentImage src={association.logoUrl} alt={`Logo di ${association.name}`} variant="logoLarge" eager /></div>
        ) : (
          <div class="hero__art" aria-hidden="true"><span>è</span></div>
        )}
      </div>
    </section>

    <HomeSections {homeSections} {notices} {initiatives} {articles} {featuredEvent} />
  </main>
</BaseLayout>
