---
import { sitePath } from '@/utils/sitePath';

const homePath = sitePath('/');
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${homePath}`} />
    <meta name="robots" content="noindex" />
    <title>Reindirizzamento</title>
  </head>
  <body>
    <p>Ti accompagniamo alla pagina iniziale. <a href={homePath}>Vai alla home</a>.</p>
  </body>
</html>
