---
import type { GetStaticPaths } from 'astro';
import EventsPage from '@/components/EventsPage.astro';
import { contentRepository } from '@/content';
import type { EventSummary } from '@/content/types';
import { eventArchivePages } from '@/utils/eventArchive';
import { getNextEvent } from '@/utils/events';

export const getStaticPaths = (async () => {
  const events = await contentRepository.listEvents();
  const nextEvent = getNextEvent(events);
  return eventArchivePages(events).map((page) => ({ params: { archive: page.route }, props: { page, nextEvent } }));
}) satisfies GetStaticPaths;

interface Props {
  page: ReturnType<typeof eventArchivePages>[number];
  nextEvent?: EventSummary;
}
const { page, nextEvent } = Astro.props;
---

<EventsPage {...page} nextEvent={nextEvent} basePath={page.year ? page.basePath : '/eventi/'} />
