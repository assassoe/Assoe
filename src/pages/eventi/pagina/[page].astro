---
import type { GetStaticPaths, Page } from 'astro';
import EventsPage from '@/components/EventsPage.astro';
import { contentRepository } from '@/content';
import type { EventSummary } from '@/content/types';
import { ARCHIVE_PAGE_SIZE } from '@/config/pagination';
import { groupEventsByDate, groupEventsByYear } from '@/utils/events';

export const getStaticPaths = (async ({ paginate }) => {
  const { past } = groupEventsByDate(await contentRepository.listEvents());
  return paginate(past, {
    pageSize: ARCHIVE_PAGE_SIZE,
    props: { years: groupEventsByYear(past).map(({ year }) => year) },
  }).slice(1);
}) satisfies GetStaticPaths;

interface Props {
  page: Page<EventSummary>;
  years: string[];
}

const { page, years } = Astro.props;
---

<EventsPage events={page.data} years={years} currentPage={page.currentPage} totalItems={page.total} />
