---
import EventsPage from '@/components/EventsPage.astro';
import { contentRepository } from '@/content';
import { ARCHIVE_PAGE_SIZE } from '@/config/pagination';
import { getNextEvent, groupEventsByDate, groupEventsByYear } from '@/utils/events';

const events = await contentRepository.listEvents();
const { past } = groupEventsByDate(events);
const years = groupEventsByYear(past).map(({ year }) => year);
---

<EventsPage events={past.slice(0, ARCHIVE_PAGE_SIZE)} nextEvent={getNextEvent(events)} years={years} totalItems={past.length} />
