---
import { sanitizeRichTextHtml } from '@/utils/sanitizeHtml';

interface Props {
  html?: string;
  basePath?: string;
}

const { html, basePath } = Astro.props;
const content = html && basePath ? sanitizeRichTextHtml(html, basePath) : html;
---

{content && <div class="detail__body" set:html={content} />}
