---
import BrandEyebrow from './BrandEyebrow.astro';
import ContentImage from './ContentImage.astro';
import type { EventSummary } from '@/content/types';
import { BRAND_WORDMARK } from '@/config/site';
import { formatDateTime } from '@/utils/date';
import { sitePath } from '@/utils/sitePath';

interface Props { event: EventSummary; }
const { event } = Astro.props;
---

<section class="section container" aria-labelledby="eventi-home">
  <div class="section__header">
    <div>
      <BrandEyebrow />
      <h2 id="eventi-home">Il prossimo appuntamento</h2>
      <p class="section__intro">Incontri, attività e momenti da condividere.</p>
    </div>
    <a class="text-link" href={sitePath('/eventi/')}>Vedi tutti gli eventi <span aria-hidden="true">↗</span></a>
  </div>
  <article class="event-feature">
    <div class="event-feature__media">
      {event.imageUrl ? (
        <ContentImage src={event.imageUrl} alt={`Locandina di ${event.title}`} variant="poster" />
      ) : (
        <div class="event-feature__placeholder" aria-hidden="true">{BRAND_WORDMARK}</div>
      )}
    </div>
    <div class="event-feature__body">
      <p class="eyebrow">Ci vediamo presto</p>
      <h3>{event.title}</h3>
      <p><time datetime={event.date}>{formatDateTime(event.date)}</time></p>
      {event.place && <p>{event.place}</p>}
      <a class="button" href={sitePath(`/eventi/${event.slug}/`)}>Scopri l’evento</a>
    </div>
  </article>
</section>
