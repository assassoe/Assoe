---
import ContentImage from './ContentImage.astro';
import RichTextContent from './RichTextContent.astro';
import type { InitiativeSpecialSection } from '@/content/types';

interface Props {
  sections?: InitiativeSpecialSection[];
  basePath?: string;
  supportLinks?: Array<{ id: string; title: string }>;
}
const { sections = [], basePath, supportLinks = [] } = Astro.props;
---

{sections.map((section, index) => (
  <section
    class:list={['initiative-special-section', section.kind === 'institutional' && 'initiative-special-section--institutional']}
    aria-labelledby={section.id}
  >
    <h2 id={section.id}>{section.title}</h2>
    {(section.kind === 'text' || section.kind === 'institutional') && <>
      {section.period && <p class="initiative-special-section__period">{section.period}</p>}
      <RichTextContent html={section.bodyHtml} {basePath} />
    </>}
    {section.kind === 'logos' && <div class="initiative-logos-banner"><ul class="initiative-logos" role="list">
      {section.logos.map((logo) => <li>
        {logo.url ? <a href={logo.url}><ContentImage src={logo.imageUrl} alt={logo.alt} variant="institutionalLogo" /></a>
          : <ContentImage src={logo.imageUrl} alt={logo.alt} variant="institutionalLogo" />}
      </li>)}
    </ul>
      {index === 0 && supportLinks.length > 0 && <div class="initiative-support-summary">
        {supportLinks.map(({ id, title }) => <p><a class="text-link" href={`#${id}`}>{title} <span aria-hidden="true">↓</span></a></p>)}
      </div>}
    </div>}
    {section.kind === 'documents' && <ul class="initiative-documents" role="list">
      {section.documents.map((document) => <li>
        <a class="text-link" href={document.url}>{document.title} <span class="initiative-documents__format">(PDF)</span></a>
        {document.description && <p>{document.description}</p>}
      </li>)}
    </ul>}
    {section.kind === 'facts' && <dl class="initiative-facts">
      {section.facts.map((fact) => <div>
        <dt>{fact.label}</dt>
        <dd>{fact.value}{fact.unit && <> {fact.unit}</>}</dd>
      </div>)}
    </dl>}
  </section>
))}
