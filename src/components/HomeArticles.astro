---
import ArticleList from './ArticleList.astro';
import type { ArticleSummary } from '@/content/types';
import { ARTICLES_TITLE } from '@/config/site';
import { sitePath } from '@/utils/sitePath';
import { selectHomeArticles } from '@/utils/featuredArticles';

interface Props { articles: ArticleSummary[]; }
const { articles } = Astro.props;
const selected = selectHomeArticles(articles);
const hasFeatured = selected.some(({ featured }) => featured === true);
---

<section class="section container" aria-labelledby="articoli-home">
  <div class="section__header">
    <div>
      <p class="eyebrow home-articles__eyebrow">{hasFeatured ? 'In evidenza' : 'Ultimi articoli'}</p>
      <h2 id="articoli-home">{ARTICLES_TITLE}</h2>
      <p class="section__intro">{hasFeatured ? 'Una selezione di storie che raccontano il nostro impegno.' : 'Le storie più recenti delle nostre attività.'}</p>
    </div>
    <a class="text-link" href={sitePath('/articoli/')}>Sfoglia gli articoli <span aria-hidden="true">↗</span></a>
  </div>
  {
    selected.length > 0 ? (
      <ArticleList articles={selected} variant="mixed" />
    ) : (
      <p class="notice">Non ci sono ancora articoli pubblicati.</p>
    )
  }
</section>
