---
/** Menu di navigazione riutilizzabile; gli href sono forniti dal chiamante. */
interface DropdownItem {
  label: string;
  href: string;
}

interface Props {
  label: string;
  items: readonly DropdownItem[];
  currentHref: string;
  navigationLabel?: string;
}

const { label, items, currentHref, navigationLabel = label } = Astro.props;
const selectedLabel = items.find(({ href }) => href === currentHref)?.label ?? 'Seleziona';
---

<details class="dropdown-nav">
  <summary>
    <span class="dropdown-nav__label">{label}</span>
    <span class="dropdown-nav__value">{selectedLabel}</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>
  <nav aria-label={navigationLabel}>
    {items.map(({ label: itemLabel, href }) => (
      <a href={href} aria-current={currentHref === href ? 'page' : undefined}>{itemLabel}</a>
    ))}
  </nav>
</details>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.dropdown-nav').forEach((filter) => {
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !filter.contains(event.target)) filter.open = false;
    });
    filter.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && filter.open) {
        filter.open = false;
        filter.querySelector('summary')?.focus();
      }
    });
    filter.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !filter.contains(event.relatedTarget)) filter.open = false;
    });
  });
</script>

<style>
  .dropdown-nav { position: relative; width: min(100%, 18rem); color: var(--green-dark); font-size: .88rem; }
  summary { display: flex; align-items: center; gap: .75rem; min-height: 2.75rem; padding: .65rem .9rem; border: 1px solid var(--line); border-radius: .65rem; background: var(--card); cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, .dropdown-nav[open] summary { border-color: var(--green); background: var(--surface-muted); }
  .dropdown-nav__label { color: var(--muted); }
  .dropdown-nav__value { margin-left: auto; font-weight: 800; }
  svg { flex-shrink: 0; }
  .dropdown-nav[open] svg { transform: rotate(180deg); }
  nav { position: absolute; z-index: 10; inset: calc(100% + .5rem) 0 auto; display: grid; gap: .2rem; max-height: 18rem; overflow-y: auto; overscroll-behavior: contain; padding: .5rem; border: 1px solid var(--line); border-radius: .65rem; background: var(--card); box-shadow: var(--shadow-menu); }
  a { display: flex; align-items: center; min-height: 2.75rem; padding: .65rem .75rem; border-radius: .4rem; font-weight: 800; text-decoration: none; }
  a:hover { background: var(--surface-muted); }
  a[aria-current='page'] { background: var(--green-dark); color: var(--card); }
  a:focus-visible { outline-offset: -3px; }
</style>
