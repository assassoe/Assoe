---
import type { InitiativeArea } from '@/content/types';
import { initiativeSections } from '@/utils/initiatives';
import { sitePath } from '@/utils/sitePath';

interface Props {
  current?: InitiativeArea;
}
const { current } = Astro.props;
---

<nav class="initiative-area-nav" aria-label="Le nostre attività">
  {initiativeSections.map(({ value, title, path }) => (
    <a class:list={{ 'initiative-area-nav__primary': value === 'volunteering' }} href={sitePath(path)} aria-current={current === value ? 'page' : undefined}>{title}</a>
  ))}
</nav>
