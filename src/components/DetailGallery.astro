---
import ContentImage from './ContentImage.astro';

interface Props {
  id: string;
  title: string;
  imageAlt: string;
  imageUrls: string[];
}

const { id, title, imageAlt, imageUrls } = Astro.props;
---

{imageUrls.length > 0 && (
  <section class="section detail-gallery" aria-labelledby={id}>
    <div class="detail-gallery__heading">
      <h2 id={id}>{title}</h2>
    </div>
    <ul class="gallery-grid">
      {imageUrls.map((url, index) => (
        <li>
          <a href={url} class="gallery-grid__button" data-gallery-open={`${id}-foto-${index + 1}`} aria-haspopup="dialog" aria-label={`Ingrandisci la foto ${index + 1} di ${imageUrls.length}`}>
            <ContentImage src={url} alt={`${imageAlt}, foto ${index + 1}`} variant="galleryThumb" />
          </a>
        </li>
      ))}
    </ul>
    {imageUrls.map((url, index) => (
      <dialog id={`${id}-foto-${index + 1}`} class="gallery-lightbox" aria-label={`Foto ${index + 1} di ${imageUrls.length}: ${imageAlt}`} tabindex="-1">
        <div class="gallery-lightbox__viewer" data-gallery-viewer>
          <div class="gallery-lightbox__toolbar" role="group" aria-label="Controlli foto">
            <span class="gallery-lightbox__counter">Foto {index + 1} / {imageUrls.length}</span>
            <button type="button" data-gallery-action="out" aria-label="Riduci zoom">−</button>
            <output data-gallery-zoom aria-live="polite" aria-label="Livello di zoom">100%</output>
            <button type="button" data-gallery-action="in" aria-label="Aumenta zoom">+</button>
            <button type="button" data-gallery-action="reset">Adatta</button>
            <button type="button" data-gallery-action="fullscreen" hidden>Schermo intero</button>
            <a href={url} target="_blank" rel="noopener noreferrer">Originale ↗</a>
            <button type="button" data-gallery-action="close" aria-label="Chiudi foto">Chiudi ×</button>
          </div>
          <div class="gallery-lightbox__stage" data-gallery-stage tabindex="0" aria-label="Foto: usa i pulsanti o la rotella per ingrandire, trascina per spostarti">
            <div class="gallery-lightbox__canvas" data-gallery-canvas>
              <ContentImage src={url} alt={`${imageAlt}, foto ${index + 1}`} variant="gallery" />
            </div>
          </div>
          <p class="visually-hidden" data-gallery-status role="status"></p>
        </div>
      </dialog>
    ))}
  </section>
)}

<script>
  import { initDetailGalleries } from '../scripts/detailGallery';

  initDetailGalleries();
</script>
