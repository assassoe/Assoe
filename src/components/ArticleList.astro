---
import ContentImage from './ContentImage.astro';
import type { ArticleSummary } from '@/content/types';
import { sitePath } from '@/utils/sitePath';
import { formatDate } from '@/utils/date';

interface Props {
  articles: ArticleSummary[];
  headingLevel?: 2 | 3;
  variant?: 'default' | 'featured' | 'mixed';
}

const { articles, headingLevel = 3, variant = 'default' } = Astro.props;
---

<ul class:list={['article-list', { 'article-list--featured': variant === 'featured' }]}>
  {articles.map((article) => (
    <li class:list={['article-list__item', { 'article-list__item--featured': variant === 'featured' || (variant === 'mixed' && article.featured === true) }]}>
      {(variant === 'featured' || (variant === 'mixed' && article.featured === true)) && (
        <>
        <span class="visually-hidden">Articolo in evidenza</span>
        <svg class="article-list__star" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m12 2.5 2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55-4.76-4.64 6.58-.96Z" />
        </svg>
        </>
      )}
      <a class:list={['article-list__link', { 'article-list__link--text-only': !article.imageUrl }]} href={sitePath(`/articoli/${article.slug}/`)}>
        {!article.historicalUndated && <time class="article-list__date" datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>}
        <div class="article-list__content">
          {headingLevel === 2 ? <h2>{article.title}</h2> : <h3>{article.title}</h3>}
          {article.summary && <p>{article.summary}</p>}
          <span class="article-list__more">Leggi l’articolo <span aria-hidden="true">↗</span></span>
        </div>
        {article.imageUrl && (
          <span class="article-list__media"><ContentImage src={article.imageUrl} alt="" variant="card" /></span>
        )}
      </a>
    </li>
  ))}
</ul>
